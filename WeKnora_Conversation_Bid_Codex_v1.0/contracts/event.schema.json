{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "job.updated",
        "analysis.ready",
        "selection.updated",
        "card.updated",
        "section.candidate_ready",
        "dependencies.stale",
        "review.completed",
        "export.ready"
      ]
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_revision": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "seq",
    "project_id",
    "event_type",
    "entity_type",
    "entity_id",
    "entity_revision",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
